 <% layout("/layouts/boilerplate") %> <%= success %>

<main class="container my-5">

  <!-- Hero Section -->
  <section class="bg-primary bg-gradient text-white text-center rounded-4 p-5 mb-5 shadow-lg">
    <h2 class="fw-bold display-6 mb-2">Explore All Listings</h2>
    <p class="mb-0 text-light fs-5">Find your next favorite stay with us</p>
  </section>

  <!-- Listings Grid -->
  <div class="row g-4">
    <% allListings.forEach(listing => { %>
      <div class="col-12 col-sm-6 col-lg-4 d-flex">
        <div class="card border-0 shadow-sm rounded-4 w-100 h-100 overflow-hidden">

          <!-- Image Section -->
          <div class="position-relative overflow-hidden" style="height: 230px;">
            <% if (listing.image && listing.image.url) { %>
              <a href="/listings/<%= listing._id %>" class="d-block h-100">
                <img 
                  src="<%= listing.image.url %>" 
                  alt="<%= listing.title %>" 
                  class="card-img-top rounded-top-4" 
                  style="object-fit: cover; height: 100%; width: 100%; transition: transform 0.4s ease;" 
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  onmouseover="this.style.transform='scale(1.05)'"
                  onmouseout="this.style.transform='scale(1)'"
                />

                <!-- Gradient Overlay -->
                <div class="image-overlay position-absolute top-0 start-0 w-100 h-100" 
                     style="background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.45)); pointer-events: none;">
                </div>

                <!-- Hidden fallback div shown if image fails -->
                <div class="fallback-box d-flex flex-column align-items-center justify-content-center"
                     style="display:none;">
                  <i class="fa-solid fa-image fa-2x mb-2"></i>
                  <p class="small mb-0 fw-semibold">Image not available</p>
                </div>
              </a>
            <% } else { %>
              <!-- Fallback When No Image Uploaded -->
              <div class="fallback-box d-flex flex-column align-items-center justify-content-center text-secondary bg-gradient"
                   style="height:100%; border-top-left-radius:1rem; border-top-right-radius:1rem;">
                <i class="fa-solid fa-image fa-3x mb-2 text-muted"></i>
                <p class="small mb-1 fw-semibold">No Image Uploaded</p>
                <span class="small text-muted">Your perfect photo awaits 📸</span>
              </div>
            <% } %>

            <!-- Favorite Icon -->
            <button 
              class="position-absolute top-0 end-0 m-3 border-0 bg-transparent p-0"
              onclick="toggleFavorite(this)"
              type="button"
              style="cursor: pointer;"
            >
              <i class="fa-regular fa-heart text-light fs-4"></i>
            </button>
          </div>

          <!-- Card Body -->
          <div class="card-body d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0 fw-semibold text-truncate"><%= listing.title %></h5>
                <span class="text-warning small fw-semibold">
                  <i class="fa-solid fa-star me-1"></i>4.7
                </span>
              </div>
              <p class="text-muted small mb-1">
                <i class="fa-solid fa-location-dot me-1 text-primary"></i>
                <%= listing.location %>, <%= listing.country %>
              </p>
              <p class="fw-bold text-primary mb-0">
                ₹ <%= listing.price.toLocaleString("en-IN") %> / night
              </p>
            </div>

            <a href="/listings/<%= listing._id %>" 
               class="btn btn-outline-primary btn-sm mt-3 rounded-pill">
              <i class="fa-solid fa-eye me-1"></i> View Details
            </a>
          </div>

        </div>
      </div>
    <% }); %>
  </div>
</main>

<!-- Favorite Toggle Script -->
<script>
  function toggleFavorite(button) {
    const icon = button.querySelector("i");
    if (icon.classList.contains("fa-regular")) {
      icon.classList.remove("fa-regular", "text-light");
      icon.classList.add("fa-solid", "text-danger");
      button.classList.add("animate-heart");
      setTimeout(() => button.classList.remove("animate-heart"), 400);
    } else {
      icon.classList.remove("fa-solid", "text-danger");
      icon.classList.add("fa-regular", "text-light");
    }
  }
</script>